# Sentinel AI Environment Configuration
# Copy this file to .env and fill in your details

# Google Gemini API Key for LLM Agent triage
GOOGLE_API_KEY=your_gemini_api_key_here

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# Apache Airflow Configuration
AIRFLOW_HOST=http://localhost:8081
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Automated retraining trigger on drift
AUTO_TRIGGER_DAG=false
